{
  "expo": {
    "name": "Frame",
    "slug": "frame-photo-library",
    "version": "0.2.0",
    "scheme": "frame",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.frame.photos",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-document-picker",
      "react-native-zip-archive",
      [
        "expo-image-picker",
        {
          "photosPermission": "Frame accesses your photo library only so you can choose photos to copy into Frame.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
